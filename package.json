{
  "name": "dsh-opencli",
  "description": "登录态浏览器自动化 dsh 插件:让 agent 用你自己登录态的真实浏览器办事——170+ 站点一步式结构化命令(site),任意网页 browser 原语兜底,写操作带审批门,采集结果经执行真实性判定。Logged-in browser automation for DeepSeek Harness: 170+ one-step structured site commands, generic browser primitives for any page, approval-gated writes, and action-evidence verification of collected results.",
  "version": "0.4.6",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "knowledge/",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "bin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IKEASven69/dsh-opencli.git"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "build:local": "node .build-tools/build.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-shell": ">=0.1.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "react": "^18.2.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.5-0"
  },
  "dependencies": {
    "@receptron/laya": "^0.1.2"
  },
  "keywords": [
    "dsh-plugin",
    "browser-automation",
    "logged-in",
    "site-commands",
    "data-product",
    "scheduled-collection",
    "provenance-report"
  ],
  "bin": {
    "dsh-opencli-ctl": "bin/dsh-opencli-ctl.cjs"
  }
}
