{
  "name": "dsh-opencli",
  "description": "登录态浏览器自动化 × dsh 插件:170+ 站点结构化命令(site)+ 通用 browser 原语 + SystemOne 亚秒决策层 + 执行真实性判定(失败说真话);write 命令带审批门。Logged-in browser automation for DeepSeek Harness: 176-site structured commands, generic browser primitives, sub-second decision layer, action-evidence verification.",
  "version": "0.4.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "SKILL.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "build:local": "node .build-tools/build.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-shell": ">=0.1.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "react": "^18.2.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "dsh": ">=0.1.5-0"
  },
  "dependencies": {
    "@receptron/laya": "^0.1.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencli",
    "browser-automation",
    "logged-in-browser",
    "site-commands",
    "watch",
    "decision-layer"
  ]
}
