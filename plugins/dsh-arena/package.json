{
  "name": "dsh-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "比武台：一个任务扇出 N 个队员各自 worktree 独立完成，diff/测试并排，选优合并",
  "bin": {
    "dsh-arena": "./bin/arena.mjs"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "arena": "tsx src/cli.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
